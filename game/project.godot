; Arena de Ídolos — prototipo local original
config_version=5

[application]
config/name="Arena de Ídolos"
run/main_scene="res://scenes/menu/main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/description="Fundación 3D: combate arcade local con recursos provisionales."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; Windows: avoid the black frame reported with Vulkan; Android keeps Mobile.
renderer/rendering_method.windows="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.06, 0.12, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[input_devices]
pointing/emulate_mouse_from_touch=false

[physics]
common/physics_ticks_per_second=60

